{
  "name": "focus-familiar",
  "productName": "Focus Familiar",
  "version": "0.1.0-prototype.7",
  "focusFamiliarBuildNumber": 7,
  "description": "A local-first productivity pet for macOS.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "lab": "vite --config vite.lab.config.ts",
    "lab:build": "vite build --config vite.lab.config.ts",
    "build": "electron-vite build && npm run build:native -- --output=out/native/focus-familiar-activity",
    "build:native": "node scripts/build-native.mjs",
    "preview": "electron-vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron-smoke": "npm run build && node scripts/electron-smoke.mjs",
    "test:sprite-edges": "find docs/design/assets/shokupan-cat/isolated src/renderer/assets/shokupan-cat -name '*.png' -print0 | sort -z | xargs -0 swift scripts/polish-sprite-edges.swift --check",
    "test:sprite-alignment": "swift scripts/normalize-pet-sprites.swift --check docs/design/assets/shokupan-cat/isolated/idle-loop/*.png src/renderer/assets/shokupan-cat/idle-loop/*.png src/renderer/assets/shokupan-cat/reactions/reaction-01-grace-glance.png src/renderer/assets/shokupan-cat/reactions/reaction-05-paw-tap.png src/renderer/assets/shokupan-cat/reactions/reaction-06-polite-wait.png src/renderer/assets/shokupan-cat/idle-actions/idle-05-forward-stretch.png src/renderer/assets/shokupan-cat/idle-actions/idle-06-paw-groom.png",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "release:macos": "node scripts/macos-release-preflight.mjs && npm run build && node scripts/package-macos.mjs --require-notarization",
    "test:packaged-smoke": "node scripts/packaged-smoke.mjs",
    "prototype": "npm run package:macos && npm run test:packaged-smoke",
    "package:validate": "node scripts/validate-package.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run lab:build && npm run package:validate"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "electron": "44.1.1",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
